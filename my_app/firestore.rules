rules_version = '2';

// Test mode: open access with a hard expiry so it cannot be forgotten.
// The app has no login yet, so anyone with the project ID can read and write
// squad data until this date. Replace with auth-based rules before real use.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 9, 12);
    }
  }
}
