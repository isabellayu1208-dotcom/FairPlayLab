rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A squad document is named after the coach's uid, so a signed-in coach can
    // only read and write their own team. Everything else is denied.
    match /teams/{teamId} {
      allow read, write: if request.auth != null && request.auth.uid == teamId;
    }
  }
}
